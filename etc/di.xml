<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="propulse_credentials" xsi:type="object">Solu1\ProPulse\Console\Command\ShowCredentials</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Backend\Model\Auth">
        <plugin name="solu1_propulse_block_service_login" type="Solu1\ProPulse\Plugin\BlockServiceLogin" sortOrder="1"/>
    </type>
    <type name="Magento\TwoFactorAuth\Model\AdminAccessTokenService">
        <plugin name="solu1_propulse_allow_service_token" type="Solu1\ProPulse\Plugin\AllowServiceToken" sortOrder="1"/>
    </type>
</config>
