{
    "name": "propulse/magento2",
    "description": "Creates a proPulse API user for Magento and shows the shop URL, username, password and a QR code.",
    "type": "magento2-module",
    "license": "GPL-3.0-or-later",
    "version": "2.0.0",
    "authors": [
        {
            "name": "Profihost GmbH",
            "homepage": "https://stathubs.com/"
        }
    ],
    "require": {
        "php": ">=8.1",
        "magento/framework": "^103.0.4",
        "magento/module-authorization": "*",
        "magento/module-backend": "*",
        "magento/module-integration": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "magento/module-user": "*"
    },
    "suggest": {
        "magento/module-two-factor-auth": "When enabled, the proPulse API user still gets a REST token; other admins keep two-factor authentication."
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Solu1\\ProPulse\\": ""
        }
    }
}
