<?php

/**
 * @var \Solu1\ProPulse\Block\Adminhtml\Credentials $block
 * @var \Magento\Framework\Escaper $escaper
 */

$credentials = $block->getCredentials();
$ready = $credentials['username'] !== '' && $credentials['password'] !== '' && $credentials['shopUrl'] !== '';
?>
<div class="propulse-layout">
    <section class="propulse-card">
        <h1><?= $escaper->escapeHtml(__('proPulse')) ?></h1>
        <?php if (!$block->isHttps()): ?>
            <p class="propulse-notice"><?= $escaper->escapeHtml(__('This shop URL is not HTTPS. Use HTTPS before connecting the shop in proPulse.')) ?></p>
        <?php endif; ?>
        <?php if (!$ready): ?>
            <p class="propulse-notice"><?= $escaper->escapeHtml(__('Could not create the proPulse API user. Reload this page after setup has finished.')) ?></p>
        <?php else: ?>
            <p class="propulse-help"><?= $escaper->escapeHtml(__('Scan the code in the proPulse app, or copy the shop URL, username and password.')) ?></p>

            <label class="propulse-field" for="propulse-shop-url">
                <span><?= $escaper->escapeHtml(__('Shop URL')) ?></span>
                <span class="propulse-field__row">
                    <input type="text" readonly="readonly" id="propulse-shop-url" value="<?= $escaper->escapeHtmlAttr($credentials['shopUrl']) ?>"/>
                    <button type="button" class="propulse-copy" data-target="propulse-shop-url"><?= $escaper->escapeHtml(__('Copy')) ?></button>
                </span>
            </label>

            <label class="propulse-field" for="propulse-username">
                <span><?= $escaper->escapeHtml(__('Username')) ?></span>
                <span class="propulse-field__row">
                    <input type="text" readonly="readonly" id="propulse-username" value="<?= $escaper->escapeHtmlAttr($credentials['username']) ?>"/>
                    <button type="button" class="propulse-copy" data-target="propulse-username"><?= $escaper->escapeHtml(__('Copy')) ?></button>
                </span>
            </label>

            <label class="propulse-field" for="propulse-password">
                <span><?= $escaper->escapeHtml(__('Password')) ?></span>
                <span class="propulse-field__row">
                    <input type="text" readonly="readonly" id="propulse-password" value="<?= $escaper->escapeHtmlAttr($credentials['password']) ?>"/>
                    <button type="button" class="propulse-copy" data-target="propulse-password"><?= $escaper->escapeHtml(__('Copy')) ?></button>
                </span>
            </label>

            <p class="propulse-help"><?= $escaper->escapeHtml(__('Scan this code in the proPulse app. It fills the shop URL, username and password.')) ?></p>
            <div id="propulse-qr" class="propulse-qr"></div>
        <?php endif; ?>
    </section>

    <section class="propulse-card">
        <h2><?= $escaper->escapeHtml(__('Permissions')) ?></h2>
        <p><strong><?= $escaper->escapeHtml(__('View only')) ?></strong></p>
        <p class="propulse-help"><?= $escaper->escapeHtml(__('View only: orders and store currency. This user cannot sign in to the admin, and cannot create, edit or delete orders.')) ?></p>
    </section>
</div>
<?php if ($ready): ?>
<script type="text/x-magento-init">
{
    "*": {
        "Solu1_ProPulse/js/credentials": <?= /* @noEscape */ $block->getJsConfigJson() ?>
    }
}
</script>
<?php endif; ?>
