<?php

/**
 * @var \Solu1\StatHubs\Block\Adminhtml\Credentials $block
 * @var \Magento\Framework\Escaper $escaper
 */

$credentials = $block->getCredentials();
$ready = $credentials['username'] !== '' && $credentials['password'] !== '' && $credentials['shopUrl'] !== '';
?>
<div class="stathubs-layout">
    <section class="stathubs-card">
        <h1><?= $escaper->escapeHtml(__('StatHubs')) ?></h1>
        <?php if (!$block->isHttps()): ?>
            <p class="stathubs-notice"><?= $escaper->escapeHtml(__('This shop URL is not HTTPS. Use HTTPS before connecting the shop in StatHubs.')) ?></p>
        <?php endif; ?>
        <?php if (!$ready): ?>
            <p class="stathubs-notice"><?= $escaper->escapeHtml(__('Could not create the StatHubs API user. Reload this page after setup has finished.')) ?></p>
        <?php else: ?>
            <p class="stathubs-help"><?= $escaper->escapeHtml(__('Scan the code in the StatHubs app, or copy the shop URL, username and password.')) ?></p>

            <label class="stathubs-field" for="stathubs-shop-url">
                <span><?= $escaper->escapeHtml(__('Shop URL')) ?></span>
                <span class="stathubs-field__row">
                    <input type="text" readonly="readonly" id="stathubs-shop-url" value="<?= $escaper->escapeHtmlAttr($credentials['shopUrl']) ?>"/>
                    <button type="button" class="stathubs-copy" data-target="stathubs-shop-url"><?= $escaper->escapeHtml(__('Copy')) ?></button>
                </span>
            </label>

            <label class="stathubs-field" for="stathubs-username">
                <span><?= $escaper->escapeHtml(__('Username')) ?></span>
                <span class="stathubs-field__row">
                    <input type="text" readonly="readonly" id="stathubs-username" value="<?= $escaper->escapeHtmlAttr($credentials['username']) ?>"/>
                    <button type="button" class="stathubs-copy" data-target="stathubs-username"><?= $escaper->escapeHtml(__('Copy')) ?></button>
                </span>
            </label>

            <label class="stathubs-field" for="stathubs-password">
                <span><?= $escaper->escapeHtml(__('Password')) ?></span>
                <span class="stathubs-field__row">
                    <input type="text" readonly="readonly" id="stathubs-password" value="<?= $escaper->escapeHtmlAttr($credentials['password']) ?>"/>
                    <button type="button" class="stathubs-copy" data-target="stathubs-password"><?= $escaper->escapeHtml(__('Copy')) ?></button>
                </span>
            </label>

            <p class="stathubs-help"><?= $escaper->escapeHtml(__('Scan this code in the StatHubs app. It fills the shop URL, username and password.')) ?></p>
            <div id="stathubs-qr" class="stathubs-qr"></div>
        <?php endif; ?>
    </section>

    <section class="stathubs-card">
        <h2><?= $escaper->escapeHtml(__('Permissions')) ?></h2>
        <p><strong><?= $escaper->escapeHtml(__('View only')) ?></strong></p>
        <p class="stathubs-help"><?= $escaper->escapeHtml(__('View only: orders and store currency. This user cannot sign in to the admin, and cannot create, edit or delete orders.')) ?></p>
    </section>
</div>
<?php if ($ready): ?>
<script type="text/x-magento-init">
{
    "*": {
        "Solu1_StatHubs/js/credentials": <?= /* @noEscape */ $block->getJsConfigJson() ?>
    }
}
</script>
<?php endif; ?>
